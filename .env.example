# System under test: rag-evolution-lab
RAGLAB_API_URL=http://host.docker.internal:18080
RAGLAB_AGENT_URL=http://host.docker.internal:8090

# LLM-assisted evaluator. The first configured key wins.
# EVALUATION_MODEL_API_KEY=replace-with-your-key
# DEEPSEEK_API_KEY=replace-with-your-existing-key
EVALUATION_MODEL_BASE_URL=https://api.deepseek.com
EVALUATION_MODEL=deepseek-chat

AGENT_EVALUATION_PORT=18200
EVALUATION_MAX_TURNS=6
EVALUATION_MAX_TOOL_CALLS=8
EVALUATION_TIMEOUT_MS=90000
EVALUATION_DATA_DIR=/var/lib/agent-evaluation
EVALUATION_DATASET_PATH=/app/datasets/raglab-medical-sales-production-sample-v2.json
DOCUMENT_QUALITY_DATASET_PATH=/app/datasets/raglab-document-quality-v1.json
