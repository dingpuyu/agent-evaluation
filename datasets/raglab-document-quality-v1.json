    },
    "holdout": {
      "purpose": "按源文档组隔离的盲测文档，防止针对可见页面过拟合。",
      "prompt_visible": false,
      "case_count": 3
    },
    "regression": {
      "purpose": "固化高置信度错字、相似型号误删和低质量文档误发布。",
      "prompt_visible": true,
      "case_count": 3
    }
  },
